<%
  var summary = strip_html(post.description || post.excerpt || post.content || '').replace(/\s+/g, ' ').trim();
  if (summary.length > 80) summary = summary.slice(0, 80) + '…';
%>
<a class="mail-row" href="<%- url_for(post.path) %>">
  <span class="mail-sender"><%= post.author || config.author %></span>
  <span class="mail-preview">
    <span class="mail-subject"><%= post.title || 'Untitled' %></span>
    <% if (summary) { %><span class="mail-excerpt"><%= summary %></span><% } %>
  </span>
  <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
</a>
