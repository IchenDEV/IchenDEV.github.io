<!DOCTYPE html>
<html lang="<%= config.language || theme.language || 'zh-CN' %>">
  <head>
    <%- partial('partials/head') %>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="terminal-shell">
      <header class="mail-masthead">
        <a class="mail-brand" href="<%- url_for('/') %>" aria-label="idevlab 博客首页">
          <span class="prompt-mark" aria-hidden="true">&gt;</span>
          <span><%= theme.terminal_title || config.title %></span>
        </a>
        <button class="theme-current" type="button" data-terminal-theme-current aria-keyshortcuts="T" aria-label="Cycle theme" title="terminal-green">terminal-green</button>
      </header>
      <div class="terminal-grid">
        <aside class="terminal-sidebar">
          <%- partial('partials/left-sidebar') %>
        </aside>
        <main class="terminal-main" id="main">
          <%- body %>
          <footer class="terminal-footer">
            <img src="<%- url_for('/footer-landscape.webp') %>" alt="" width="2172" height="724" loading="lazy" decoding="async">
            <div class="terminal-footer-copy">
              <span>© <%= new Date().getFullYear() %> <%= config.author || theme.site_brand_name %></span>
              <span>&gt; <%= theme.footer_text %></span>
            </div>
          </footer>
        </main>
      </div>
    </div>
    <%- partial('partials/search-data') %>
    <% (theme.scripts || []).forEach(function(script) { %>
      <script src="<%- url_for(script) %>" defer></script>
    <% }); %>
  </body>
</html>
