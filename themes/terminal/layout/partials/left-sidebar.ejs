<%
  var currentFolder = '';
  if (is_home() || is_post()) currentFolder = 'home';
  else if (is_archive() || is_category() || is_tag() || page.layout === 'category' || page.layout === 'tag') currentFolder = 'archives';
  else if (page.path === 'about/index.html') currentFolder = 'about';
%>
<nav class="terminal-nav" aria-label="Navigation">
  <% Object.keys(theme.menu || {}).forEach(function(label) { %>
    <% var target = String(label).replace(/^_/, ''); %>
    <a href="<%- url_for(theme.menu[label]) %>" data-terminal-nav="<%= target %>" <% if (target === currentFolder) { %>aria-current="page"<% } %>>
      <span class="nav-marker" aria-hidden="true"><%= target === currentFolder ? '>' : '' %></span>
      <span><%= label %></span>
    </a>
  <% }); %>
</nav>
<div class="mail-search">
  <label class="search-line">
    <span class="sr-only">Search</span>
    <input type="search" placeholder="Search..." data-terminal-search-input aria-keyshortcuts="/" aria-controls="search-results">
    <kbd aria-hidden="true">/</kbd>
  </label>
  <div class="search-results" id="search-results" data-terminal-search-results aria-live="polite" hidden></div>
</div>
